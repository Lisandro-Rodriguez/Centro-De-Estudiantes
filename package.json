{
  "name": "centro-estudiantes",
  "version": "1.0.0",
  "description": "Sistema de gestión para centros de estudiantes",
  "main": "src/main/index.js",
  "scripts": {
    "start": "npx electron .",
    "dev": "npx electron . --dev",
    "build": "npx electron-builder build --win --publish always",
    "build:local": "npx electron-builder build --win --publish never"
  },
  "build": {
    "appId": "com.centro.estudiantes",
    "productName": "Centro Estudiantes",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "TU_USUARIO_GITHUB",
      "repo": "centro-estudiantes"
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "author": "",
  "license": "MIT"
}